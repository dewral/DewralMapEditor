<RCC>
    <qresource prefix="/">
        <!-- Wymusza styl Basic Qt Quick Controls (Qt czyta :/qtquickcontrols2.conf
             automatycznie). Bez tego Windows uzywa stylu natywnego, ktory ignoruje
             wlasne delegaty menu (zolte podswietlenie, centrowany tekst). -->
